---
const {
  src,
  alt,
  class: className = '',
  loading = 'lazy',
  fill = false,
} = Astro.props;
---
<img
  class={`image-tile ${fill ? 'image-tile--fill' : ''} ${className}`.trim()}
  src={src}
  alt={alt}
  loading={loading}
  decoding="async"
/>

<style>
  .image-tile {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: cover;
    background: #f3f0e8;
  }

  .image-tile--fill {
    width: 100%;
    height: 100%;
    max-width: none;
  }
</style>
