---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchInfoPosts } from '../lib/content-api';

const posts = await fetchInfoPosts();

const stripTags = (value: unknown) => String(value ?? '').replace(/<[^>]*>/g, '').trim();
const formatDate = (value: unknown) => {
  const date = new Date(String(value || ''));
  if (Number.isNaN(date.getTime())) return '';
  return date.toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' });
};

const toPreview = (post: (typeof posts)[number]) => {
  const source = stripTags(post.excerpt || post.content || '');
  return source.length > 190 ? `${source.slice(0, 190)}...` : source;
};
---
<BaseLayout pageTitle="Info | Lab hair design" pageDescription="Lab Hair Design の地域ブログ・お知らせ一覧ページ">
  <section class="section info-blog" style="padding: 0; border-top: 0;">
    <div style="max-width: 760px; width: 94%; margin: 0 auto; text-align: center; padding: 52px 20px 38px; box-sizing: border-box;">
    <div class="info-blog__head">
      <p class="info-blog__label">Info</p>
      <h1 class="info-blog__title">地域ブログ・お知らせ</h1>
      <p class="info-blog__lead">日々の記録やお知らせを、静かに更新しています。</p>
    </div>

    <div class="info-blog__list" aria-live="polite">
      {posts.length ? (
        posts.map((post) => {
          const dateLabel = formatDate(post.date);
          const preview = toPreview(post);
          const pathKey = post.slug || post.id;
          return (
            <article class="info-post-card">
              {post.thumbnail ? (
                <a class="info-post-card__thumb-wrap" href={`/info-post/${pathKey}`}>
                  <img src={post.thumbnail} alt={post.title} loading="lazy" />
                </a>
              ) : null}

              <div class="info-post-card__body">
                {dateLabel ? <p class="info-post-card__date">{dateLabel}</p> : null}
                <h2 class="info-post-card__title">
                  <a href={`/info-post/${pathKey}`}>{post.title}</a>
                </h2>
                {preview ? <p class="info-post-card__excerpt">{preview}</p> : null}
              </div>
            </article>
          );
        })
      ) : (
        <p class="info-blog__status">投稿はまだありません。</p>
      )}
    </div>
    </div>
  </section>

  <style>
    .info-blog {
      display: grid;
      place-items: center;
      width: 100%;
      padding-top: 0;
    }

    :global(main.main-content) {
      max-width: 760px !important;
      width: 94% !important;
      margin: 0 auto !important;
      text-align: center !important;
      padding: 40px 20px !important;
      box-sizing: border-box !important;
    }

    .info-blog__head {
      width: 100%;
      margin: 0 auto 1.6rem;
      text-align: center;
      display: grid;
      gap: 0.5rem;
    }

    .info-blog__label {
      margin: 0;
      font-size: 0.62rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      opacity: 0.72;
      font-weight: 300;
      color: rgba(0, 0, 0, 0.58);
    }

    .info-blog__title {
      margin: 0;
      font-size: 1rem;
      line-height: 1.7;
      letter-spacing: 0.08em;
      font-weight: 300;
      color: rgba(0, 0, 0, 0.78);
    }

    .info-blog__lead {
      margin: 0;
      font-size: 0.72rem;
      line-height: 1.95;
      opacity: 0.72;
      font-weight: 300;
      color: rgba(0, 0, 0, 0.62);
    }

    .info-blog__list {
      width: 100%;
      margin: 0 auto;
      display: grid;
      gap: 2.25rem;
    }

    .info-blog__status {
      margin: 0;
      text-align: center;
      font-size: 0.78rem;
      letter-spacing: 0.06em;
      opacity: 0.64;
      padding: 2.7rem 0;
      font-weight: 300;
      color: rgba(0, 0, 0, 0.58);
    }

    .info-post-card {
      width: 100%;
      margin: 0 auto;
      display: grid;
      gap: 1.05rem;
      align-items: start;
      padding: 0 0 2rem;
      border-bottom: 1px solid rgba(17, 17, 17, 0.08);
      text-align: left;
      transition: opacity 220ms ease;
    }

    .info-post-card:hover {
      opacity: 0.9;
    }

    .info-post-card__thumb-wrap {
      width: 100%;
      display: block;
      text-align: center;
      text-decoration: none;
      outline: none;
    }

    .info-post-card__thumb-wrap img {
      display: inline-block;
      width: min(100%, 620px);
      height: auto;
      border-radius: 12px;
    }

    .info-post-card__body {
      display: grid;
      gap: 0.62rem;
      width: min(100%, 620px);
      margin: 0 auto;
    }

    .info-post-card__date {
      margin: 0;
      font-size: 0.62rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      opacity: 1;
      font-weight: 200;
      color: rgba(0, 0, 0, 0.6);
    }

    .info-post-card__title {
      margin: 0;
      font-size: 0.88rem;
      line-height: 1.9;
      letter-spacing: 0.05em;
      font-weight: 200;
      color: rgba(0, 0, 0, 0.6);
    }

    .info-post-card__title a {
      color: inherit;
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 220ms ease, opacity 220ms ease;
    }

    .info-post-card__title a:hover {
      border-color: rgba(0, 0, 0, 0.22);
      opacity: 0.86;
    }

    .info-post-card__excerpt {
      margin: 0;
      font-size: 0.72rem;
      line-height: 2;
      letter-spacing: 0.02em;
      font-weight: 300;
      color: rgba(0, 0, 0, 0.62);
      text-align: left;
      white-space: normal;
    }
  </style>
</BaseLayout>
