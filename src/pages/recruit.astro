---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchRecruitContent } from '../lib/content-api';

const recruitContent = await fetchRecruitContent();
const philosophyTitle = recruitContent.title;
const philosophyParagraphs = recruitContent.bodyParagraphs;
const recruitConditions = recruitContent.conditions;
---
<BaseLayout pageTitle="Recruit | Lab hair design" pageDescription="Lab hair design の採用ページ">
  <section class="section recruit-philosophy">
    <div class="recruit-philosophy__inner">
      <p class="recruit-philosophy__label">Philosophy</p>
      <h1 class="recruit-philosophy__headline" id="recruit-title">{philosophyTitle}</h1>
      <div id="recruit-body">
        {philosophyParagraphs.map((line) => (
          <p class="recruit-philosophy__text">{line}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="section recruit-conditions" aria-label="募集条件">
    <div class="recruit-conditions__inner">
      {recruitConditions.map((item) => (
        <article class="recruit-conditions__item">
          <p class="recruit-conditions__label">{item.label}</p>
          <p class="recruit-conditions__text">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <style>
    .recruit-philosophy,
    .recruit-conditions {
      display: grid;
      place-items: center;
      padding-top: 4.4rem;
    }

    .recruit-philosophy__inner,
    .recruit-conditions__inner {
      width: min(560px, 100%);
      display: grid;
      gap: 1rem;
    }

    .recruit-philosophy__label,
    .recruit-conditions__label {
      margin: 0;
      font-size: 0.64rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      opacity: 0.72;
    }

    .recruit-philosophy__headline {
      margin: 0;
      font-size: clamp(0.92rem, 2vw, 1.08rem);
      line-height: 1.9;
      letter-spacing: 0.1em;
      font-weight: 600 !important;
      color: #111 !important;
      opacity: 1 !important;
    }

    .recruit-philosophy__text {
      margin: 0;
      font-size: 0.76rem;
      line-height: 2;
      font-weight: 400 !important;
      color: #111 !important;
      opacity: 1 !important;
    }

    .recruit-conditions {
      padding-top: 2rem;
    }

    .recruit-conditions__item {
      padding: 0.95rem 0;
      border-bottom: 1px solid rgba(17, 17, 17, 0.08);
    }

    .recruit-conditions__text {
      margin: 0.35rem 0 0;
      font-size: 0.78rem;
      line-height: 1.8;
    }
  </style>
</BaseLayout>
