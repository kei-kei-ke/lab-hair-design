---
import Header from '../components/Header.astro';
const pageTitle = Astro.props.pageTitle ?? 'Lab hair design';
const pageDescription = Astro.props.pageDescription ?? 'Minimal hair salon site.';
const reserveUrl =
  Astro.props.reserveUrl ??
  'https://beauty.hotpepper.jp/CSP/bt/reserve/?storeId=H000286767';

---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100;200;300;400&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        color: #111;
        background: #fff;
        --font-sans: 'Noto Sans JP', 'Helvetica Neue', Arial, sans-serif;
        --font-serif: 'Noto Sans JP', 'Helvetica Neue', Arial, sans-serif;
        font-family: var(--font-sans);
        font-size: 16px;
        line-height: 1.5;
        letter-spacing: 0.1em;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html {
        scroll-behavior: smooth;
        font-family: 'Noto Sans JP', 'Helvetica Neue', Arial, sans-serif !important;
        font-weight: 200 !important;
        letter-spacing: 0.1em !important;
      }
      body {
        margin: 0;
        min-height: 100vh;
        background: #fff;
        color: #111;
        font-family: 'Noto Sans JP', 'Helvetica Neue', Arial, sans-serif !important;
        font-weight: 200 !important;
        letter-spacing: 0.1em !important;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }
      body, html, *, p, span, a, h1, h2, h3, div, td, th {
        font-family: 'Noto Sans JP', 'Helvetica Neue', Arial, sans-serif !important;
        font-weight: 200 !important;
        letter-spacing: 0.1em !important;
      }
      body :is(p, a, span, li, dt, dd, small, label, input, textarea, button) {
        font-weight: 200 !important;
        letter-spacing: 0.1em !important;
      }
      body :is(h1, h2, h3, h4, h5, h6) {
        font-weight: 300 !important;
        letter-spacing: 0.1em !important;
      }
      img, video { display: block; max-width: 100%; height: auto; }
      a { color: inherit; text-decoration: none; }
      ul { margin: 0; padding: 0; list-style: none; }
      button { font: inherit; cursor: pointer; }

      .page-header {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr) max-content;
        align-items: end;
        column-gap: 1.15em;
        width: min(100%, 1200px);
        margin: 0 auto;
        padding: 1.25em 1.5em 1em;
        min-width: 0;
        font-size: clamp(7px, 0.9vw, 12px);
        line-height: 1;
        border-bottom: 1px solid rgba(17,17,17,0.06);
      }
      .brand {
        display: flex;
        align-items: end;
        min-width: 0;
      }
      .brand__link {
        display: inline-flex;
        color: inherit;
        text-decoration: none;
        min-width: 0;
      }
      .brand__title {
        margin: 0;
        font-size: 1.6em !important;
        letter-spacing: 0.12em;
        font-weight: 400;
        line-height: 1.05;
        white-space: nowrap;
      }
      .header-nav {
        display: grid;
        grid-template-columns: repeat(2, max-content);
        column-gap: 1.55em;
        row-gap: 0.42em;
        align-items: end;
        justify-content: center;
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
      }
      .header-nav__link {
        font-size: 0.9em !important;
        letter-spacing: 0.072em;
        text-transform: uppercase;
        color: rgba(46, 49, 53, 0.84);
        white-space: nowrap;
        flex: 0 0 auto;
        position: relative;
      }
      .header-nav__link:hover { color: rgba(46, 49, 53, 0.98); }
      .header-nav__link:nth-child(1) { justify-self: start; transform: translate3d(0, 0, 0); }
      .header-nav__link:nth-child(2) { justify-self: end; transform: translate3d(18px, 8px, 0); }
      .header-nav__link:nth-child(3) { justify-self: start; transform: translate3d(12px, 6px, 0); }
      .header-nav__link:nth-child(4) { justify-self: end; transform: translate3d(28px, 9px, 0); }
      .header-tools {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: max-content;
        align-items: end;
        justify-content: end;
        gap: 0.45em;
        white-space: nowrap;
        flex: 0 0 auto;
      }
      .header-button { display: none; }
      .header-icon {
        width: 1.4em;
        height: 1.4em;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(17, 17, 17, 0.5);
        border-radius: 999px;
      }
      .header-icon:hover { opacity: 0.92; }
      .header-icon--instagram {
        border-color: rgba(17, 17, 17, 0.42);
      }
      .header-icon--line {
        border-color: rgba(17, 17, 17, 0.42);
        font-size: 0.5rem;
        line-height: 1;
        text-transform: uppercase;
      }

      .main-content {
        width: min(100%, 1200px);
        padding: 0 1.5rem 5.5rem;
        margin: 0 auto;
      }

      .hero-shell {
        display: grid;
        grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
        gap: 5.2rem;
        margin-top: 6.6rem;
      }
      .hero-panel {
        display: grid;
        grid-template-columns: repeat(2, max-content);
        column-gap: 1.55em;
        row-gap: 0.42em;
        align-items: end;
        justify-content: center;
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        font-size: 0.68rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        letter-spacing: 0.072em;
      }
        color: rgba(46, 49, 53, 0.84);
      .panel-card a {
        font-size: 0.82rem;
        position: relative;
        letter-spacing: 0.02em;
      .header-nav__link:hover { color: rgba(46, 49, 53, 0.98); }
      .header-nav__link:nth-child(1) { justify-self: start; transform: translate3d(0, 0, 0); }
      .header-nav__link:nth-child(2) { justify-self: end; transform: translate3d(18px, 8px, 0); }
      .header-nav__link:nth-child(3) { justify-self: start; transform: translate3d(12px, 6px, 0); }
      .header-nav__link:nth-child(4) { justify-self: end; transform: translate3d(28px, 9px, 0); }
      }
      .panel-list {
        display: grid;
        gap: 1rem;
      }
      .panel-list li a {
        display: block;
        opacity: 0.9;
        line-height: 1.5;
      }
      .panel-list li span {
        display: block;
        margin-top: 0.22rem;
        font-size: 0.64rem;
        opacity: 0.6;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .hero-card-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(180px, 1fr));
        grid-template-rows: repeat(4, minmax(96px, auto));
        gap: 2.6rem;
        max-width: 560px;
        justify-content: flex-start;
        align-content: start;
      }
      .hero-card {
        position: relative;
        overflow: hidden;
        border-radius: 12px;
        width: 100%;
        min-height: 110px;
        background: #f3f0e8;
      }
      .hero-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(0,0,0,0.04));
        pointer-events: none;
      }
      .hero-card__label {
        position: absolute;
        left: 0.7rem;
        bottom: 0.55rem;
        z-index: 1;
        font-size: 0.62rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #fff;
        text-shadow: 0 1px 10px rgba(0,0,0,0.35);
      }
      .hero-card--large {
        grid-column: 1 / span 2;
        width: 100%;
        min-height: 260px;
      }
      .hero-card--tall { min-height: 190px; }
      .hero-card--small { min-height: 120px; }
      .hero-card--accent { background: #f1eee7; }
      .hero-card > .image-tile,
      .image-card > .image-tile {
        position: absolute;
        inset: 0;
        max-width: 100%;
      }

      .section {
        padding: 10rem 0;
        border-top: 1px solid rgba(17,17,17,0.06);
      }
      .section-head {
        display: grid;
        gap: 0.3rem;
        margin-bottom: 0.9rem;
      }
      .section-label {
        margin: 0;
        font-size: 0.68rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        opacity: 0.68;
      }
      .section-title {
        margin: 0;
        font-family: var(--font-serif);
        font-size: clamp(1.15rem, 1.8vw, 1.5rem);
        line-height: 1.08;
        letter-spacing: 0.1em;
        font-weight: 400;
      }
      .section-copy {
        margin: 0;
        max-width: 42rem;
        font-size: 0.84rem;
        line-height: 1.85;
        color: #444;
      }

      .image-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(180px, 1fr));
        gap: 3rem;
        justify-content: flex-start;
      }
      .image-card {
        width: 100%;
        min-height: 170px;
        border-radius: 12px;
        background: #f3f0e8;
        position: relative;
        overflow: hidden;
      }
      .image-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(0,0,0,0.04));
        pointer-events: none;
      }
      .image-card__title {
        position: absolute;
        left: 0.7rem;
        bottom: 0.55rem;
        margin: 0;
        font-size: 0.62rem;
        letter-spacing: 0.05em;
        color: #fff;
        text-shadow: 0 1px 8px rgba(0,0,0,0.32);
      }
      .view-all {
        display: inline-flex;
        margin-top: 3rem;
        font-size: 0.68rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0.84;
      }

      .staff-hero,
      .info-hero,
      .price-hero,
      .access-hero,
      .recruit-hero,
      .shop-hero {
        max-width: 56rem;
      }
      .staff-hero--minimal,
      .price-hero--minimal,
      .hair-top--minimal {
        padding-bottom: 1rem;
      }

      .staff-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(170px, 1fr));
        gap: 4rem;
        justify-content: flex-start;
        margin-top: 1.6rem;
      }
      .staff-card {
        display: grid;
        gap: 0.55rem;
      }
      .staff-card__image {
        width: 100%;
        min-height: 200px;
        border-radius: 10px;
        overflow: hidden;
        background: #f3f0e8;
      }
      .staff-card__image > .image-tile { max-width: 100%; }
      .staff-card__meta {
        display: grid;
        gap: 0.22rem;
      }
      .staff-card__role {
        margin: 0;
        font-size: 0.64rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0.68;
      }
      .staff-card__name {
        margin: 0;
        font-size: 0.86rem;
        line-height: 1.5;
        letter-spacing: 0.01em;
      }
      .staff-card__text {
        margin: 0;
        font-size: 0.74rem;
        line-height: 1.7;
        color: #444;
      }

      .info-list {
        display: grid;
        gap: 1.3rem;
        margin-top: 1.4rem;
      }
      .info-card,
      .access-card,
      .access-note,
      .recruit-role,
      .recruit-cta__box,
      .shop-preview__card,
      .shop-preview__note,
      .price-note__box {
        padding: 0.95rem 0;
        border-bottom: 1px solid rgba(17,17,17,0.08);
      }
      .info-card__date,
      .access-card__label,
      .access-note__title,
      .recruit-role__label,
      .recruit-cta__eyebrow,
      .shop-preview__label,
      .shop-preview__note-label,
      .price-note__label,
      .price-card__label,
      .price-section__label,
      .recruit-details__term,
      .recruit-editorial__kicker,
      .recruit-editorial__quote-label,
      .shop-preview__kicker,
      .quote-tag,
      .shop-label,
      .line-label,
      .hair-card__tag,
      .hair-top__crumb {
        margin: 0;
        font-size: 0.58rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0.68;
      }
      .hair-category {
        margin: 0;
